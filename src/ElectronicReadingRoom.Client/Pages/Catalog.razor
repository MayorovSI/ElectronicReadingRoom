@page "/catalog"
@inject ApiService ApiService
@inject ModeService ModeService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Каталог</PageTitle>

<h1 class="mb-4">Каталог документов</h1>

@if (ModeService.IsLibrarian)
{
    <a class="btn btn-primary mb-3" href="/documents/add">Добавить документ</a>
}

<div class="row g-2 mb-4">
    <div class="col-lg-5 col-md-6">
        <input type="text" class="form-control" placeholder="Поиск по названию, автору, году..."
               @bind="SearchQuery" @bind:event="oninput"
               @onkeyup="OnSearchKeyUp" />
    </div>
    <div class="col-lg-3 col-md-3">
        <select class="form-select" value="@SelectedGenreId" @onchange="OnGenreChanged">
            <option value="">Все жанры</option>
            @foreach (var genre in genres)
            {
                <option value="@genre.Id">@genre.Name</option>
            }
        </select>
    </div>
    <div class="col-lg-2 col-md-3">
        <select class="form-select" value="@SortBy" @onchange="OnSortChanged">
            <option value="title">По названию</option>
            <option value="year">По году</option>
            <option value="author">По автору</option>
        </select>
    </div>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-warning">@_loadError</div>
}

@if (documents.Any())
{
    <div class="catalog-grid">
        @foreach (var doc in documents)
        {
            <div @key="doc.Id" class="card h-100 doc-card card-hover">
                <div class="doc-card-main">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <a href="/documents/@doc.Id" class="text-decoration-none">@doc.Title</a>
                        </h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            @string.Join(", ", doc.DocumentAuthors.Select(da => da.Author?.Name ?? ""))
                        </h6>
                        <p class="card-text">
                            <small class="text-muted">@doc.Year г.</small>
                        </p>
                        @if (doc.File is not null)
                        {
                            <span class="badge-format @GetFormatClass(doc.File.Format) mb-2 align-self-start">
                                <span aria-hidden="true">@GetFormatIcon(doc.File.Format)</span>
                                @doc.File.Format.ToUpperInvariant()
                            </span>
                        }
                        @if (doc.DocumentGenres.Any())
                        {
                            <div class="mt-auto">
                                @foreach (var dg in doc.DocumentGenres)
                                {
                                    <span class="badge bg-secondary me-1">@dg.Genre?.Name</span>
                                }
                            </div>
                        }
                    </div>
                    @if (doc.File is not null)
                    {
                        <div class="doc-cover" data-cover-id="@doc.Id"
                             data-cover-format="@doc.File.Format"
                             data-cover-url="@ApiService.GetDownloadUrl(doc.Id)"
                             role="img" aria-label="Первая страница: @doc.Title">
                            <span class="doc-cover-placeholder">@doc.Title</span>
                        </div>
                    }
                    else
                    {
                        <div class="doc-cover doc-cover-fallback" role="img" aria-label="@doc.Title">
                            <span>@doc.Title</span>
                        </div>
                    }
                </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <a href="/documents/@doc.Id" class="btn btn-sm btn-outline-primary w-100">Подробнее</a>
                    </div>
            </div>
        }
    </div>

    <nav class="mt-4" aria-label="Пагинация">
        <ul class="pagination justify-content-center">
            <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="#" @onclick="PrevPage" @onclick:preventDefault="true">&laquo; Назад</a>
            </li>
            <li class="page-item active">
                <span class="page-link">@_currentPage</span>
            </li>
            <li class="page-item @(_currentPage * PageSize >= _totalCount ? "disabled" : "")">
                <a class="page-link" href="#" @onclick="NextPage" @onclick:preventDefault="true">Вперёд &raquo;</a>
            </li>
        </ul>
    </nav>
}
else if (_loadError is null)
{
    <div class="alert alert-info">
        Документы не найдены.
    </div>
}

@code {
    private List<Document> documents = [];
    private List<Genre> genres = [];
    private string? SearchQuery;
    private string? SelectedGenreId;
    private string SortBy = "title";
    private int _currentPage = 1;
    private int _totalCount;
    private const int PageSize = 9;
    private string? _loadError;
    private bool _shouldObserveCovers = true;
    private int? SelectedGenreIdInt => int.TryParse(SelectedGenreId, out var id) ? id : (int?)null;

    private static string GetFormatClass(string format) => $"badge-{format.ToLowerInvariant()}";

    private static string GetFormatIcon(string format) => format.ToLowerInvariant() switch
    {
        "pdf" => "📕",
        "epub" => "📗",
        "djvu" => "📘",
        "docx" => "📝",
        _ => "📄"
    };

    protected override async Task OnInitializedAsync()
    {
        ModeService.ModeChanged += () => { _shouldObserveCovers = true; StateHasChanged(); };
        try
        {
            genres = await ApiService.GetAllGenresAsync();
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            _loadError = $"Ошибка загрузки: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldObserveCovers)
        {
            _shouldObserveCovers = false;
            await JS.InvokeVoidAsync("viewerInterop.observeCatalogCovers");
        }
    }

    public void Dispose()
    {
        ModeService.ModeChanged -= StateHasChanged;
    }

    private async Task LoadDocuments()
    {
        try
        {
            _loadError = null;
            var result = await ApiService.GetDocumentsAsync(_currentPage, PageSize, SearchQuery, SelectedGenreIdInt, SortBy);
            documents = result.Items;
            _totalCount = result.Total;
        }
        catch (Exception ex)
        {
            _loadError = $"Ошибка загрузки: {ex.Message}";
            documents = [];
        }
        _shouldObserveCovers = true;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadDocuments();
        }
    }

    private async Task OnGenreChanged(ChangeEventArgs e)
    {
        SelectedGenreId = e.Value?.ToString();
        _currentPage = 1;
        await LoadDocuments();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        SortBy = e.Value?.ToString() ?? "title";
        _currentPage = 1;
        await LoadDocuments();
    }

    private async Task PrevPage()
    {
        if (_currentPage > 1) { _currentPage--; await LoadDocuments(); }
    }

    private async Task NextPage()
    {
        if (_currentPage * PageSize < _totalCount) { _currentPage++; await LoadDocuments(); }
    }
}
