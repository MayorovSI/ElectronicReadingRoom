@page "/"
@inject ModeService ModeService
@inject NavigationManager Navigation

<PageTitle>Электронный читальный зал</PageTitle>

<div class="landing-page">
    <h1 class="mb-3 text-center">Электронный читальный зал</h1>
    <p class="lead text-muted mb-5 text-center">Выберите режим работы</p>

    <div class="role-grid">
        <div class="card h-100 text-center role-card role-reader" role="button" tabindex="0" @onclick="SelectReader" @onkeydown="HandleReaderKeyDown">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <div class="role-icon mb-3" aria-hidden="true">📖</div>
                    <h4 class="card-title">Читатель</h4>
                    <p class="card-text text-muted">Просмотр каталога, поиск и чтение документов</p>
                </div>
        </div>
        <div class="card h-100 text-center role-card role-librarian" role="button" tabindex="0" @onclick="SelectLibrarian" @onkeydown="HandleLibrarianKeyDown">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <div class="role-icon mb-3" aria-hidden="true">📚</div>
                    <h4 class="card-title">Библиотекарь</h4>
                    <p class="card-text text-muted">Управление каталогом, жанрами и документами</p>
                </div>
        </div>
    </div>
</div>

@code {
    private void HandleReaderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") SelectReader();
    }

    private void HandleLibrarianKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") SelectLibrarian();
    }

    private void SelectReader()
    {
        ModeService.SetMode(AppMode.Reader);
        Navigation.NavigateTo("/catalog");
    }

    private void SelectLibrarian()
    {
        ModeService.SetMode(AppMode.Librarian);
        Navigation.NavigateTo("/catalog");
    }
}
